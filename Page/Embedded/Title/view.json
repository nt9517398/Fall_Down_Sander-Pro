{
  "custom": {},
  "params": {
    "icon": "home",
    "text": "Home"
  },
  "propConfig": {
    "params.icon": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.text": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 56,
      "width": 600
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Icon"
        },
        "position": {
          "basis": "24px",
          "shrink": 0
        },
        "propConfig": {
          "props.path": {
            "binding": {
              "config": {
                "expression": "{view.params.icon}"
              },
              "type": "expr"
            },
            "persistent": false
          }
        },
        "props": {
          "style": {
            "classes": "Title/Icon",
            "marginLeft": "10px"
          }
        },
        "type": "ia.display.icon"
      },
      {
        "meta": {
          "hasDelegate": true,
          "name": "Label"
        },
        "position": {
          "basis": 100,
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.text"
              },
              "type": "property"
            },
            "persistent": false
          }
        },
        "props": {
          "style": {
            "classes": "Title/Text"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "hasDelegate": true,
          "name": "Label_2"
        },
        "position": {
          "basis": 100,
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "\"Shift: \" + {[default]sander_falldown/falldown/product/shift}"
              },
              "type": "expr"
            },
            "persistent": false
          }
        },
        "props": {
          "style": {
            "classes": "Title/Text"
          },
          "textStyle": {
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "hasDelegate": true,
          "name": "Label_0"
        },
        "position": {
          "basis": 100,
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "\"Product: \" + {[default]sander_falldown/falldown/product/thickness} + \"mm\" + \" \" + {[default]sander_falldown/falldown/product/product} + \" \" + {[default]sander_falldown/falldown/product/grade}"
              },
              "type": "expr"
            },
            "persistent": false
          }
        },
        "props": {
          "style": {
            "classes": "Title/Text"
          },
          "textStyle": {
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "hasDelegate": true,
          "name": "Label_1"
        },
        "position": {
          "basis": 100,
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "\"Grade: \" + {[default]sander_falldown/falldown/product/grade}"
              },
              "type": "expr"
            },
            "persistent": false
          }
        },
        "props": {
          "style": {
            "classes": "Title/Text"
          },
          "textStyle": {
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "hasDelegate": true,
          "name": "Label_3"
        },
        "position": {
          "basis": 100,
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "\"Face: \" + {[default]sander_falldown/falldown/product/face} + \"mm\""
              },
              "type": "expr"
            },
            "persistent": false
          }
        },
        "props": {
          "style": {
            "classes": "Title/Text"
          },
          "textStyle": {
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "hasDelegate": true,
          "name": "Label_4"
        },
        "position": {
          "basis": 100,
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "\"Width: \" + {[default]sander_falldown/falldown/product/width} + \"mm\""
              },
              "type": "expr"
            },
            "persistent": false
          }
        },
        "props": {
          "style": {
            "classes": "Title/Text"
          },
          "textStyle": {
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "hasDelegate": true,
          "name": "Label_5"
        },
        "position": {
          "basis": 100,
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "\"Length: \" + {[default]sander_falldown/falldown/product/length} + \"mm\""
              },
              "type": "expr"
            },
            "persistent": false
          }
        },
        "props": {
          "style": {
            "classes": "Title/Text"
          },
          "textStyle": {
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "style": {
        "classes": "Title/Title"
      }
    },
    "type": "ia.container.flex"
  }
}