{
  "custom": {},
  "params": {
    "TagDescription": "HOLDING TANK TRANSFER PUMP LEVEL SWITCH",
    "TagName": "_100LSL0308",
    "orientation": "value"
  },
  "propConfig": {
    "params.TagDescription": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.TagName": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.orientation": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 27,
      "width": 27
    }
  },
  "root": {
    "children": [
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "draggable": false,
                "id": "rTg4rsqK",
                "modal": false,
                "overlayDismiss": false,
                "resizable": false,
                "showCloseIcon": false,
                "type": "open",
                "viewParams": {
                  "TagDescription": "{this.custom.TagDescription}",
                  "TagName": "{this.custom.TagName}"
                },
                "viewPath": "Templates/LevelSwitch_Faceplate",
                "viewportBound": false
              },
              "scope": "C",
              "type": "popup"
            }
          }
        },
        "meta": {
          "name": "Sensor_35",
          "tooltip": {
            "enabled": true
          }
        },
        "propConfig": {
          "custom.TagDescription": {
            "binding": {
              "config": {
                "path": "view.params.TagDescription"
              },
              "type": "property"
            }
          },
          "custom.TagName": {
            "binding": {
              "config": {
                "path": "view.params.TagName"
              },
              "type": "property"
            }
          },
          "meta.tooltip.text": {
            "binding": {
              "config": {
                "path": "this.custom.TagName"
              },
              "type": "property"
            }
          },
          "props.label.style.visibility": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "direct",
                "tagPath": "[default]TagNamesMemoryBit"
              },
              "type": "tag"
            }
          },
          "props.label.text": {
            "binding": {
              "config": {
                "path": "this.custom.TagName"
              },
              "enabled": false,
              "type": "property"
            }
          },
          "props.orientation": {
            "binding": {
              "config": {
                "path": "view.params.orientation"
              },
              "type": "property"
            }
          },
          "props.state": {
            "binding": {
              "config": {
                "expression": "if(\r\n  tag(\"[default]\"+{this.custom.TagName} + \"/FLT\"),\r\n  \"faulted\",\r\n  if(\r\n    tag(\"[default]\"+{this.custom.TagName}+ \"/INPUT\"),\r\n    \"running\",\r\n    \"stopped\"\r\n  )\r\n)"
              },
              "type": "expr"
            }
          },
          "props.value.text": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "TagName": "{this.custom.TagName}"
                },
                "tagPath": "[default]{TagName}/ACTUAL"
              },
              "enabled": false,
              "transforms": [
                {
                  "formatType": "numeric",
                  "formatValue": "integer",
                  "type": "format"
                },
                {
                  "expression": "{value} + {this.custom.EngUnit}",
                  "type": "expression"
                }
              ],
              "type": "tag"
            }
          }
        },
        "props": {
          "appearance": "p\u0026id",
          "label": {
            "location": "bottom",
            "style": {
              "backgroundColor": "#FFFFFF80"
            },
            "text": ""
          },
          "value": {
            "style": {
              "fontSize": 20
            },
            "text": ""
          }
        },
        "type": "ia.symbol.sensor"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}