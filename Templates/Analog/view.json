{
  "custom": {},
  "params": {
    "EngUnit": "value",
    "TagDescription": "value",
    "TagName": "value"
  },
  "propConfig": {
    "params.EngUnit": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.TagDescription": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.TagName": {
      "paramDirection": "input",
      "persistent": true
    },
    "props.defaultSize.width": {
      "binding": {
        "config": {
          "path": "view.params.width"
        },
        "enabled": false,
        "type": "property"
      }
    }
  },
  "props": {
    "defaultSize": {
      "height": 32,
      "width": 50
    }
  },
  "root": {
    "children": [
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "draggable": false,
                "id": "DZxb09lC",
                "modal": false,
                "overlayDismiss": false,
                "resizable": false,
                "showCloseIcon": false,
                "type": "open",
                "viewParams": {
                  "EngUnit": "{this.custom.EngUnit}",
                  "TagDescription": "{this.custom.TagDescription}",
                  "TagName": "{this.custom.TagName}"
                },
                "viewPath": "Templates/Instrument_Faceplate",
                "viewportBound": false
              },
              "scope": "C",
              "type": "popup"
            }
          }
        },
        "meta": {
          "name": "Analog_0"
        },
        "propConfig": {
          "custom.EngUnit": {
            "binding": {
              "config": {
                "path": "view.params.EngUnit"
              },
              "type": "property"
            }
          },
          "custom.TagDescription": {
            "binding": {
              "config": {
                "path": "view.params.TagDescription"
              },
              "type": "property"
            }
          },
          "custom.TagName": {
            "binding": {
              "config": {
                "path": "view.params.TagName"
              },
              "type": "property"
            }
          },
          "props.style.classes": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "TagName": "{this.custom.TagName}"
                },
                "tagPath": "[default]{TagName}/STATUS_WORD"
              },
              "transforms": [
                {
                  "fallback": "Header/Alarm_Active",
                  "inputType": "scalar",
                  "mappings": [
                    {
                      "input": 1,
                      "output": ""
                    }
                  ],
                  "outputType": "style-list",
                  "type": "map"
                }
              ],
              "type": "tag"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "TagName": "{this.custom.TagName}"
                },
                "tagPath": "[default]{TagName}/ACTUAL"
              },
              "transforms": [
                {
                  "formatType": "numeric",
                  "formatValue": "##.#",
                  "type": "format"
                },
                {
                  "expression": "{value} + {this.custom.EngUnit}",
                  "type": "expression"
                }
              ],
              "type": "tag"
            }
          }
        },
        "props": {
          "style": {},
          "textStyle": {
            "backgroundColor": "#FFFFFF",
            "borderStyle": "ridge",
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}