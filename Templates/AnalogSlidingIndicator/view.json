{
  "custom": {},
  "params": {
    "TagName": "_130LI0703"
  },
  "propConfig": {
    "params.TagName": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 270,
      "width": 60
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "MovingAnalogIndicator"
        },
        "propConfig": {
          "custom.TagName": {
            "binding": {
              "config": {
                "path": "view.params.TagName"
              },
              "type": "property"
            }
          },
          "props.desiredHigh": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "TagName": "{this.custom.TagName}"
                },
                "tagPath": "[default]{TagName}/HSP"
              },
              "type": "tag"
            }
          },
          "props.desiredLow": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "TagName": "{this.custom.TagName}"
                },
                "tagPath": "[default]{TagName}/LSP"
              },
              "type": "tag"
            }
          },
          "props.highAlarm": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "TagName": "{this.custom.TagName}"
                },
                "tagPath": "[default]{TagName}/HSP"
              },
              "type": "tag"
            }
          },
          "props.highHighAlarm": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "TagName": "{this.custom.TagName}"
                },
                "tagPath": "[default]{TagName}/HHSP"
              },
              "type": "tag"
            }
          },
          "props.lowAlarm": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "TagName": "{this.custom.TagName}"
                },
                "tagPath": "[default]{TagName}/LSP"
              },
              "type": "tag"
            }
          },
          "props.lowLowAlarm": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "TagName": "{this.custom.TagName}"
                },
                "tagPath": "[default]{TagName}/LLSP"
              },
              "type": "tag"
            }
          },
          "props.maxValue": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "TagName": "{this.custom.TagName}"
                },
                "tagPath": "[default]{TagName}/MAXE"
              },
              "type": "tag"
            }
          },
          "props.minValue": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "TagName": "{this.custom.TagName}"
                },
                "tagPath": "[default]{TagName}/MINE"
              },
              "type": "tag"
            }
          },
          "props.processValue": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "TagName": "{this.custom.TagName}"
                },
                "tagPath": "[default]{TagName}/ACTUAL"
              },
              "type": "tag"
            }
          }
        },
        "props": {
          "highInterlock": null,
          "label": {
            "format": "#,##0.0",
            "visible": true
          },
          "lowInterlock": null,
          "reverseIndicator": true
        },
        "type": "ia.display.moving-analog-indicator"
