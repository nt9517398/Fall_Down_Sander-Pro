                  "config": {
                    "script": "\t# Import necessary modules\n\timport time\n\n\t# Define the tag path [default]_02MOT0101/RS\n\tTagName \u003d self.view.params.TagName\n\ttagPath \u003d \"[default]{}/LRST\".format(TagName)\n\t\n\t# Function to activate the tag\n\tdef activateTag():\n\t    # Write the value to the tag to activate it\n\t    system.tag.writeBlocking([tagPath], [True])\n\t    print(\"Tag activated.\")\n\t\n\t# Function to deactivate the tag\n\tdef deactivateTag():\n\t    # Write the value to the tag to deactivate it\n\t    system.tag.writeBlocking([tagPath], [False])\n\t    print(\"Tag deactivated.\")\n\t\n\t# Main function\n\tdef main():\n\t    # Activate the tag\n\t    activateTag()\n\t    \n\t    # Wait for 2 seconds\n\t    time.sleep(2)\n\t    \n\t    # Deactivate the tag\n\t    deactivateTag()\n\t\n\t# Run the main function\n\tmain()"
                  },
